rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function isStaff() {
      return authenticated() && exists(profilePath())
        && get(profilePath()).data.active == true;
    }
    function isOwner() {
      return isStaff() && get(profilePath()).data.role == 'owner';
    }
    function isBarber() {
      return isStaff() && get(profilePath()).data.role == 'barber';
    }
    function validAppointment() {
      return request.resource.data.keys().hasOnly([
        'barberId', 'first', 'last', 'phone', 'date', 'time',
        'service', 'walkIn', 'createdAt'
      ])
      && request.resource.data.keys().hasAll([
        'barberId', 'first', 'last', 'phone', 'date', 'time',
        'service', 'walkIn', 'createdAt'
      ])
      && request.resource.data.barberId is string
      && request.resource.data.barberId.size() > 0
      && request.resource.data.first is string
      && request.resource.data.first.size() > 0
      && request.resource.data.first.size() <= 70
      && request.resource.data.last is string
      && request.resource.data.last.size() > 0
      && request.resource.data.last.size() <= 70
      && request.resource.data.phone is string
      && request.resource.data.phone.size() <= 24
      && request.resource.data.date is string
      && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && request.resource.data.time is string
      && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')
      && request.resource.data['service'] is string
      && request.resource.data['service'].size() <= 100
      && request.resource.data.walkIn is bool
      && request.resource.data.createdAt == request.time;
    }
    match /staff/{uid} {
      allow get: if authenticated() && request.auth.uid == uid || isOwner();
      allow list: if isOwner();
      allow create: if isOwner()
        && request.resource.data.role == 'barber'
        && request.resource.data.active == true;
      allow update: if isOwner()
        && resource.data.role == 'barber'
        && request.resource.data.role == 'barber';
      allow delete: if isOwner() && resource.data.role == 'barber';
    }
    match /barbers/{barberId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    match /appointments/{slot} {
      allow get: if isOwner() || (isBarber() && resource.data.barberId == request.auth.uid);
      allow list: if isOwner() || (isBarber() && resource.data.barberId == request.auth.uid);
      allow create: if validAppointment()
        && (isOwner() || (isBarber() && request.resource.data.barberId == request.auth.uid))
        && slot == request.resource.data.barberId + '_' + request.resource.data.date + '_' + request.resource.data.time;
      allow update: if false;
      allow delete: if isOwner() || (isBarber() && resource.data.barberId == request.auth.uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
